pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	psize_x = 10
	psize_y = 20
	
	pf1 = {}
	
	for y=1,20 do
    pf1[y]={}
    for x=1,10 do
      pf1[y][x]=0
    end
  end
	
end

function _update()

end

function _draw()
	cls()
	map(0)
  render_playfields()
end

function render_playfields()
  -- playfield 1
	line(15, 31, 56, 31, 8)
	line(15, 31, 15, 112, 8)
	line(15, 112, 56, 112, 8)
	line(56, 31, 56, 112, 8)

  -- playfield 2
	line(71, 31, 112, 31, 11)
	line(71, 31, 71, 112, 11)
	line(71, 112, 112, 112, 11)
	line(112, 31, 112, 112, 11)

	for x=1,10 do
		for y=1,20 do
			spr(pf1[y][x], 12+4*x, 28+4*y, 0.5, 0.5)
		end
	end

	for x=1,10 do
		for y=1,20 do
			spr(pf1[y][x], 68+4*x, 28+4*y, 0.5, 0.5)
		end
	end
end

end

function draw_piece(piece, rotation, x, y, color)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  local bricks = pieces[piece][rotation]

  for block in all(bricks) do
    if color == nil then
      spr(piece, x+block[1]*4, y+block[2]*4, 0.5, 0.5)
    else
      spr(color, x+block[1]*4, y+block[2]*4, 0.5, 0.5)
    end
  end
end

function handle_timer(player)
  player.milli += 1

  if player.milli > 0 and player.milli % 60 == 0 then
    player.milli -= 60
    player.seconds += 1
  end

  if player.seconds > 0 and player.seconds % 60 == 0 then
    player.seconds -= 60
    player.minutes += 1
  end
end

function draw_timer(player)
  local color = 13

  if player.win then
    color = 9
  elseif not player.alive then
    color = 1
  end

  local seconds = player.seconds
  local minutes = player.minutes

  if minutes < 10 then minutes = "0" .. minutes end
  if seconds < 10 then seconds = "0" .. seconds end
  print(minutes .. ":" .. seconds, player.x_offset + 20, player.y_offset + 86, color)
end

function draw_splits(player)
  for index, split in pairs(player.splits) do
    print((index-1) * 100 .. ": " .. split, player.x_offset + 5, player.y_offset + (8 * index) - 3, 13)
  end
end

-->8
-- logic

function handle_gravity(player)
  player.lock = 0
  internal_gravity = get_level_gravity(player.level)
  if player.insta then
    internal_gravity = 5120
  end

  if player.soft and internal_gravity < 256 then
    player.gravity += 1
  else
    player.gravity += internal_gravity / 256
  end

  while player.gravity > 1 do
    player.row += 1

    if check_grounded(player) then
      player.gravity = 0
    else
      player.gravity -= 1
    end
  end
end

function handle_lock(player)
  player.lock += 1

  if player.lock < 30 and player.soft then
    player.lock = 29
  elseif player.lock >= 30 then
    place_piece(player)

    local lines_to_clear = detect_lines(player)

    if #lines_to_clear > 0 then
      player.lines_to_clear = lines_to_clear
      player.clear = 41
    end
  end
end

function handle_spawn(player)
  if player.are <= 0 then
    next_piece(player)
  end

  player.are -= 1
end

function handle_clear(player)
  if player.clear > 0 then
    player.clear -= 1
  end

  if player.clear == 10 then
    clear_lines(player)
  end
end

function handle_death(player)
  if player.delay > 0 then
    if player.delay % 4 == 0 and player.delay > 0 then
      for column=1,10 do
        if player.playfield[player.delay / 4][column] != 0 then
          player.playfield[player.delay / 4][column] = 18
        end
      end
    end

    player.delay -= 1
  end
end

function detect_lines(player)
  clears = {}

	for y=1,22 do
    count = 0

		for x=1,10 do
      if player.playfield[y][x] != 0 then
        count += 1
      end
		end
    if count >= 10 then
      add(clears, y)
    end
	end

  return clears
end

function clear_lines(player)
  for clear in all(player.lines_to_clear) do
    deli(player.playfield, clear)
    temp = {}
    for column=1,10 do
      add(temp, 0)
    end
    add(player.playfield, temp, 1)

    increase_level(player, true)
  end

  player.lines_to_clear = {}
end

function get_level_gravity(level)
  if level < 30 then
    return 4
  elseif level < 35 then
    return 6
  elseif level < 40 then
    return 8
  elseif level < 50 then
    return 10
  elseif level < 60 then
    return 12
  elseif level < 70 then
    return 16
  elseif level < 80 then
    return 32
  elseif level < 90 then
    return 48
  elseif level < 100 then
    return 64
  elseif level < 120 then
    return 80
  elseif level < 140 then
    return 96
  elseif level < 160 then
    return 112
  elseif level < 170 then
    return 128
  elseif level < 200 then
    return 144
  elseif level < 220 then
    return 4
  elseif level < 230 then
    return 32
  elseif level < 233 then
    return 64
  elseif level < 236 then
    return 96
  elseif level < 239 then
    return 128
  elseif level < 243 then
    return 160
  elseif level < 247 then
    return 192
  elseif level < 251 then
    return 224
  elseif level < 300 then
    return 256
  elseif level < 330 then
    return 512
  elseif level < 360 then
    return 768
  elseif level < 400 then
    return 1024
  elseif level < 420 then
    return 1280
  elseif level < 450 then
    return 1024
  elseif level < 500 then
    return 768
  end

  return 5120
end

function next_piece(player)
  --needs bag system
  -- grabs piece shown in preview
  player.current = player.next
  player.next = retrieve_piece(player)
  player.row = 2
  player.lock = 0

  -- irs always prioritizes a over b
  if player.lspin or player.l2spin then
    player.rotation = 4
  elseif player.rspin then
    player.rotation = 2
  else
    player.rotation = 1
  end

  player.column = 4

  if is_any_tile_taken(player) then
    place_piece(player)
    kill_player(player)
  end

  increase_level(player, false)
end

function retrieve_piece(player)
  local next = flr(rnd(7)+1)

  for i=1,4 do
    if table_contains(player.history, next) then
      next = flr(rnd(7)+1)
    end
  end

  deli(player.history, 1)
  add(player.history, next)
  return next
end

function retrieve_initial_piece(player)
  local next = flr(rnd(7)+1)

  while next == 2 or next == 3 or next == 6 do
    next = flr(rnd(7)+1)
  end

  return next
end

function place_piece(player)
  local piece = pieces[player.current][player.rotation]

  for block in all(piece) do
    player.playfield[player.row + block[2]][player.column + block[1]] = player.current
  end

  player.lock = 0
  player.are = 30
end

function init_playfield()
  local pf = {}

  for row=1,22 do
    pf[row]={}
    for column=1,10 do
      pf[row][column]=0
    end
  end

  return pf
end

function init_player(num)
  local x_offsets = {4, 76}
  local y_offsets = {32, 32}-- unused for now :thinking:

  local player = {
    num = num,
    playfield = init_playfield(),
    history = {2, 2, 2, 2},
    column = 4,
    row = 2,
    level = 1,
    gravity = 0,
    lines_to_clear = {},

    x_offset = x_offsets[num+1],
    y_offset = y_offsets[num+1],

    -- delays
    are = -1,
    das = 0,
    lock = 0,
    clear = 0,
    delay = -1,

    -- timer
    milli = 0,
    seconds = 0,
    minutes = 0,

    rotation = 1,
    lspin = false,
    l2spin = false,
    rspin = false,
    soft = false,

    alive = true,
    win = false,

    splits = {},
    draw_splits = false,

    -- modes
    code = "",
    insta = false,
    invis = false
  }

  if start_insta then
    player.insta = true
    start_insta = false
  end

  if start_invis then
    player.invis = true
    start_invis = false
  end

  player.current = retrieve_initial_piece(player)
  player.next = retrieve_piece(player)

  return player
end

function kill_player(player)
  player.delay = 80
  player.alive = false
  player.start_insta = false
  player.start_invis = false
  player.lspin = false -- doesn't poll otherwise until anim is done
end

function increase_level(player, cleared)
  if player.level == 999 and cleared then
    save_split(player)
    player.win = true
  elseif (player.level + 1) % 100 != 0 or cleared then
    player.level += 1
  end

  if player.level % 100 == 0 and cleared then
    save_split(player)
  end
end

function save_split(player)
  local seconds = player.seconds
  local minutes = player.minutes

  if minutes < 10 then minutes = "0" .. minutes end
  if seconds < 10 then seconds = "0" .. seconds end

  add(player.splits, minutes .. ":" .. seconds)
end

function check_grounded(player)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  local piece = pieces[player.current][player.rotation]
  local x = player.column
  local y = player.row

  for block in all(piece) do
    local bx = x + block[1]
    local by = y + block[2]

    if by+1 > #player.playfield or
     player.playfield[by+1][bx] != 0 then
      return true
    end
  end

  return false
end

function check_walls(player, move)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  local piece = pieces[player.current][player.rotation]
  local x = player.column
  local y = player.row

  for block in all(piece) do
    local bx = x + block[1]
    local by = y + block[2]
    if bx+move < 1 or bx+move > 10 then
      return true
    end

    if player.playfield[by][bx+move] != 0 then
      return true
    end
  end

  return false
end

function move_piece(player, direction)
  if direction == 0 then
    if not check_walls(player, -1) then
      player.column -= 1
    end
  end

  if direction == 1 then
    if not check_walls(player, 1) then
      player.column += 1
    end
  end
end

function spin_piece(player, direction)
  if direction == 0 then
    decrease_rotation(player)

    if not check_kicks(player, -1) then
      increase_rotation(player)
    end
  end

  if direction == 1 then
    increase_rotation(player)

    if not check_kicks(player, 1) then
      decrease_rotation(player)
    end
  end
end

function decrease_rotation(player)
  player.rotation -= 1

  if player.rotation < 1 then
    player.rotation = 4
  end
end

function increase_rotation(player)
  player.rotation += 1

  if player.rotation > 4 then
    player.rotation = 1
  end
end

-- returns true upon no rules broken
--  or a successful kick
function check_kicks(player, direction)
  local piece = pieces[player.current][player.rotation]
  local x = player.column
  local y = player.row

  if player.current == 1 then -- i
    if is_any_tile_taken(player) then
      return false
    end
  elseif player.current == 2 or
    player.current == 3 then
    if not passes_ars(player) then
      return false
    end
  elseif player.current == 4 or -- j
    player.current == 5 or -- l
    player.current == 7 then -- t
    if not passes_column_check_ars(player) then
      return false
    end
  end

  return true
end

function passes_ars(player)
  if is_any_tile_taken(player) then
    if try_regular_kick(player) then
      return true
    else
      return false
    end
  end

  return true
end

function passes_column_check_ars(player)
  if is_any_tile_taken(player) then
    if center_column_rule(player) then
      if try_regular_kick(player) then
        return true
      else
        return false
      end
    else
      return false
    end
  end

  return true
end

function try_regular_kick(player)
  player.column += 1

  if is_any_tile_taken(player) then
    player.column -= 1
  else
    return true
  end

  player.column -= 1

  if is_any_tile_taken(player) then
    player.column += 1
  else
    return true
  end

  return false
end

function center_column_rule(player, center)
  for x=0,2 do
    for y=0,2 do
      local bx = player.column + x
      local by = player.row + y

      if is_tile_taken(player.playfield, bx, by) and not x == 1 then
        return true
      elseif is_tile_taken(player.playfield, bx, by) and x == 1 then
        return false
      end
    end
  end

  return true
end

function is_tile_taken(playfield, x, y)
  if playfield[y] == nil or playfield[y][x] == nil then
    return true
  elseif playfield[y][x] != 0 then
    return true
  end

  return false
end

function is_any_tile_taken(player)
  local piece = pieces[player.current][player.rotation]
  local x = player.column
  local y = player.row

  for block in all(piece) do
    local bx = x + block[1]
    local by = y + block[2]

    if is_tile_taken(player.playfield, bx, by) then return true end
  end

  return false
end


-->8
-- input

function handle_game_input(player)
  -- movement
  local down = btn(3, player.num)
  local left = btn(0, player.num)
  local right = btn(1, player.num)

  if down then
    player.soft = true
  else
    player.soft = false

    if left and right then
      player.das = 0
    elseif left then
      if player.das == 0 then
        move_piece(player, 0)
      elseif player.das <= -16 then
        move_piece(player, 0)
      elseif player.das > 0 then
        move_piece(player, 0)
        player.das = 0
      end

      player.das -= 1
    elseif right then
      if player.das == 0 then
        move_piece(player, 1)
      elseif player.das >= 16 then
        move_piece(player, 1)
      elseif player.das < 0 then
        move_piece(player, 1)
        player.das = 0
      end

      player.das += 1
    else
      player.das = 0
    end
  end

  -- rotation
  local x = btn(5, player.num)
  local o = btn(4, player.num)
  local up = btn(2, player.num)

  if x then
    if not player.lspin then
      spin_piece(player, 0)
    end

    player.lspin = true
  else
    player.lspin = false
  end

  if up and three_button_spin then
    if not player.l2spin then
      spin_piece(player, 0)
    end

    player.l2spin = true
  else
    player.l2spin = false
  end

  if o then
    if not player.rspin then
      spin_piece(player, 1)
    end

    player.rspin = true
  else
    player.rspin = false
  end
end

function handle_menu_input(player)
  -- movement
  local left = btnp(0, player.num)
  local right = btnp(1, player.num)
  local up = btnp(2, player.num)
  local down = btnp(3, player.num)
  local x = btnp(5, player.num)
  local o = btnp(4, player.num)
  local held_x = btn(5, player.num)
  local held_o = btn(4, player.num)

  if held_x and not held_o then
    player.lspin = true
  elseif player.lspin and not held_x and not held_o then
    players[player.num + 1] = init_player(player.num)

    player.lspin = false
  else
    player.lspin = false
  end

  if o and #player.splits > 0 then
    if player.draw_splits then
      player.draw_splits = false
    else
      player.draw_splits = true
    end
  end

  if held_x and held_o then
    if left then
      player.code = player.code .. '0'
    end
    if right then
      player.code = player.code .. '1'
    end
    if up then
      player.code = player.code .. '2'
    end
    if down then
      player.code = player.code .. '3'
    end

    if #player.code > 8 then
      player.code = sub(player.code, 2, 9)
    end

    if player.code == "33333333" then
      start_insta = true
      printh("20g code active")
    end

    if player.code == "031130" then
      start_invis = true
      printh("invis code active")
    end
  end

end


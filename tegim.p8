pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  pieces = {
    {{0,0},{1,0},{2,0},{3,0}}, -- i
    {{0,0},{1,0},{1,1},{2,1}}, -- z
    {{0,1},{1,0},{1,1},{2,0}}, -- s
    {{0,0},{1,0},{2,0},{2,1}}, -- j
    {{0,0},{0,1},{1,0},{2,0}}, -- l
    {{0,0},{1,0},{0,1},{1,1}}, -- o
    {{0,0},{1,0},{1,1},{2,0}}  -- t
  }

  psize_x = 10
  psize_y = 20

  pf1 = init_playfield()
  pf2 = init_playfield()

  for i=1,10 do
    pf1[i][18] = 7
  end

  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  p1 = init_player(0)
  p2 = init_player(1)
end

function _update60()
  if check_grounded(p1, pf1) then
    p1.grounded = true
  else
    p1.grounded = false
    handle_gravity(p1)
  end

  if check_grounded(p2, pf2) then
    p2.grounded = true
  else
    p2.grounded = false
    handle_gravity(p2)
  end

  handle_input(p1)
  handle_input(p2)
end

function _draw()
  cls()
  map(0)
  render_playfields()
  render_previews()
  render_currents()
  render_debug()
end

function render_previews()
  draw_piece(p1.next, 30, 16)
  draw_piece(p2.next, 86, 16)
end

function render_playfields()
  -- playfield 1
	line(15, 31, 56, 31, 8)
	line(15, 31, 15, 112, 8)
	line(15, 112, 56, 112, 8)
	line(56, 31, 56, 112, 8)

  -- playfield 2
	line(71, 31, 112, 31, 11)
	line(71, 31, 71, 112, 11)
	line(71, 112, 112, 112, 11)
	line(112, 31, 112, 112, 11)

	for x=1,10 do
		for y=1,20 do
			spr(pf1[x][y], 12+4*x, 28+4*y, 0.5, 0.5)
		end
	end

	for x=1,10 do
		for y=1,20 do
			spr(pf2[x][y], 68+4*x, 28+4*y, 0.5, 0.5)
		end
	end
end

function render_currents()
  draw_piece(p1.current, 12+4*p1.column, 28+4*p1.row)
  draw_piece(p2.current, 68+4*p2.column, 28+4*p2.row)
end

function render_debug()
  print(p1.gravity, 2, 2)
  --print(p1.grounded, 8, 2)
  --print(p1.column, 50, 2)
  --print(p1.row, 60, 2)
  print(p1.das, 40, 2)

	for x=1,10 do
		for y=1,20 do
      if pf1[x][y] != 0 then
        print("x", 12+4*x, 28+4*y)
      else
        print(".", 12+4*x, 28+4*y)
      end
		end
	end
end


-->8
-- pieces

function draw_piece(piece, x, y)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  for brick in all(pieces[piece]) do
    spr(piece, x+brick[1]*4, y+brick[2]*4, 0.5, 0.5)
  end
end

-->8
-- physics

function handle_gravity(player)
  player.gravity += 1
  if player.gravity > 10 then
    player.row += 1
    player.gravity = 0
  end
end

function next_piece()
  --needs bag system
  return flr(rnd(6)+1)
end

function init_playfield()
  local pf = {}

  for column=1,10 do
    pf[column]={}
    for row=1,20 do
      pf[column][row]=0
    end
  end

  return pf
end

function init_player(num)
  return {
    num = num,
    next = flr(rnd(6)+1),
    current = flr(rnd(6)+1),
    row = 1,
    das = 0,
    column = 4,
    gravity = 0,
    rotation = 0,
    grounded = false
  }
end

function check_grounded(player, playfield)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  local piece = player.current
  local x = player.column
  local y = player.row

  for block in all(pieces[piece]) do
    local bx = x + block[1]
    local by = y + block[2]
    if playfield[bx][by+1] != 0 then
      return true
    end
  end

  return false
end

function move_piece(player, playfield, direction)
  if direction == 0 and player.column > 1 then
    player.column -= 1
  end

  if direction == 1 and player.column < 7 then
    player.column += 1
  end
end


-->8
-- input

function handle_input(player)
  local left = btn(0, player.num)
  local right = btn(1, player.num)

  if left and right then
    player.das = 0
    return
  end

  if left then
    if player.das == 0 then
      move_piece(p1, pf1, 0)
    elseif player.das <= -16 then
      move_piece(p1, pf1, 0)
    elseif player.das > 0 then
      move_piece(p1, pf1, 0)
      player.das = 0
    end

    player.das -= 1
  elseif right then
    if player.das == 0 then
      move_piece(p1, pf1, 1)
    elseif player.das >= 16 then
      move_piece(p1, pf1, 1)
    elseif player.das < 0 then
      move_piece(p1, pf1, 1)
      player.das = 0
    end

    player.das += 1
  else
    player.das = 0
  end
end


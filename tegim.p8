pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  pieces = {
    {{0,0},{1,0},{2,0},{3,0}}, -- i
    {{0,0},{1,0},{1,1},{2,1}}, -- z
    {{0,1},{1,0},{1,1},{2,0}}, -- s
    {{0,0},{1,0},{2,0},{2,1}}, -- j
    {{0,0},{0,1},{1,0},{2,0}}, -- l
    {{0,0},{1,0},{0,1},{1,1}}, -- o
    {{0,0},{1,0},{1,1},{2,0}}  -- t
  }

  psize_x = 10
  psize_y = 20

  pf1 = init_playfield()
  pf2 = init_playfield()

  pf1[3][10] = 7
  pf1[4][10] = 7
  pf1[5][10] = 7
  pf1[6][10] = 7
  pf1[7][10] = 7

  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  p1 = init_player(1)
  p2 = init_player(2)
end

function _update60()
  if check_grounded(p1, pf1) then
    p1.grounded = true
  else
    p1.grounded = false
    handle_gravity(p1)
  end

  if check_grounded(p2, pf2) then
    p2.grounded = true
  else
    p2.grounded = false
    handle_gravity(p2)
  end

  handle_input(p1)
  handle_input(p2)
end

function _draw()
  cls()
  map(0)
  render_playfields()
  render_previews()
  render_currents()
  --render_debug()
end

function render_previews()
  draw_piece(p1.next, 30, 16)
  draw_piece(p2.next, 86, 16)
end

function render_playfields()
  -- playfield 1
	line(15, 31, 56, 31, 8)
	line(15, 31, 15, 112, 8)
	line(15, 112, 56, 112, 8)
	line(56, 31, 56, 112, 8)

  -- playfield 2
	line(71, 31, 112, 31, 11)
	line(71, 31, 71, 112, 11)
	line(71, 112, 112, 112, 11)
	line(112, 31, 112, 112, 11)

	for x=1,10 do
		for y=1,20 do
			spr(pf1[x][y], 12+4*x, 28+4*y, 0.5, 0.5)
      if pf1[x][y] != 0 then
        print("x", 12+4*x, 28+4*y)
      else
        print(".", 12+4*x, 28+4*y)
      end

		end
	end

	for x=1,10 do
		for y=1,20 do
			spr(pf2[x][y], 68+4*x, 28+4*y, 0.5, 0.5)
		end
	end
end

function render_currents()
  draw_piece(p1.current, 12+4*p1.column, 28+4*p1.row)
  draw_piece(p2.current, 68+4*p2.column, 28+4*p2.row)
end

function render_debug()
  print(p1.gravity, 2, 2)
  print(p1.grounded, 8, 2)
  print(p1.column, 50, 2)
  print(p1.row, 60, 2)
end


-->8
-- pieces

function draw_piece(piece, x, y)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  for brick in all(pieces[piece]) do
    spr(piece, x+brick[1]*4, y+brick[2]*4, 0.5, 0.5)
  end
end

-->8
-- physics

function handle_gravity(player)
  player.gravity += 1
  if player.gravity > 10 then
    player.row += 1
    player.gravity = 0
  end
end

function next_piece()
  --needs bag system
  return flr(rnd(6)+1)
end

function init_playfield()
  pf = {}

  for column=1,10 do
    pf[column]={}
    for row=1,20 do
      pf[column][row]=0
    end
  end

  return pf
end

function init_player(player_num)
  return {
    num = player,
    next = flr(rnd(6)+1),
    current = flr(rnd(6)+1),
    row = 1,
    column = 4,
    gravity = 0,
    rotation = 0,
    grounded = false
  }
end

function check_grounded(player, playfield)
  -- 1=I, 2=Z, 3=S, 4=J, 5=L, 6=O, 7=T
  piece = player.current
  x = player.column
  y = player.row

  for brick in all(pieces[piece]) do
  end

  if piece == 1 then
    if playfield[x][y+1] != 0 or
       playfield[x+1][y+1] != 0 or
       playfield[x+2][y+1] != 0 or
       playfield[x+3][y+1] != 0 then
      return true
    end
  elseif piece == 2 then
    if playfield[x][y+1] != 0 or
       playfield[x+1][y+2] != 0 or
       playfield[x+2][y+2] != 0 then
      return true
    end
  elseif piece == 3 then
    if playfield[x+2][y] != 0 or
       playfield[x+2][y+1] != 0 or
       playfield[x+1][y+2] != 0 then
      return true
    end
  elseif piece == 4 then
    if playfield[x+1][y] != 0 or
       playfield[x+1][y+1] != 0 or
       playfield[x+2][y+2] != 0 then
      return true
    end
  elseif piece == 5 then
    if playfield[x+2][y] != 0 or
       playfield[x+1][y+1] != 0 or
       playfield[x+1][y+2] != 0 then
      return true
    end
  elseif piece == 6 then
    if playfield[x+2][y+1] != 0 or
       playfield[x+2][y+2] != 0 then
      return true
    end
  elseif piece == 7 then
    if playfield[x+1][y] != 0 or
       playfield[x+2][y+1] != 0 or
       playfield[x+1][y+2] != 0 then
      return true
    end
  end

  return false
end

-->8
-- input

function handle_input(player)
  if btn(0, player.num) then
    player.column -= 1
  end

  if btn(1, player.num) then
    player.column += 1
  end
end

